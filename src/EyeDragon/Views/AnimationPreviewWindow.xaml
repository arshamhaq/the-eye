<Window x:Class="EyeDragon.Views.AnimationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dragon Animation Preview" Width="680" Height="600" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Animation Preview" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Preview every pose immediately—this does not affect the active timer." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" />
            <ComboBox x:Name="AnimationPicker" SelectionChanged="AnimationPicker_SelectionChanged" Padding="8" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18" CornerRadius="20" Background="#181222" Padding="20">
            <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PlayPauseButton" Content="Pause" Click="PlayPauseButton_Click" MinWidth="110" />
            <Button Content="Previous frame" Click="PreviousButton_Click" Background="#423153" Margin="10,0" />
            <Button Content="Next frame" Click="NextButton_Click" Background="#423153" />
        </StackPanel>
    </Grid>
</Window>
