<Window x:Class="EyeDragon.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeDragon" Width="410" Height="610" MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip">
    <Border Margin="10" CornerRadius="22" Background="{StaticResource PageBrush}" BorderBrush="#493665" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="EyeDragon" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding OpenSettingsCommand}" Content="⚙" Background="Transparent" Padding="14,8" ToolTip="Settings" />
                    <Button Command="{Binding HideCommand}" Content="—" Background="Transparent" Padding="14,8" ToolTip="Hide to tray" />
                    <Button Click="CloseButton_Click" Content="×" Background="Transparent" Padding="14,8" ToolTip="Hide to tray" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="28,10,28,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="265" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border CornerRadius="18" Background="#181222" Padding="14">
                    <Image Source="{Binding PetImage}" Stretch="Uniform" SnapsToDevicePixels="True" />
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel Visibility="{Binding IdleVisibility}" VerticalAlignment="Center">
                        <TextBlock Text="Ready to focus?" Foreground="{StaticResource TextBrush}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Your dragon will keep watch." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center" />
                        <Button Command="{Binding StartWorkingCommand}" Content="Start Working" HorizontalAlignment="Center" MinWidth="185" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding WorkingVisibility}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RemainingText}" Foreground="{StaticResource TextBrush}" FontSize="55" FontWeight="Light" FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,2,0,22" HorizontalAlignment="Center" />
                        <Button Command="{Binding RestingNowCommand}" Content="Resting Now" Background="#423153" HorizontalAlignment="Center" MinWidth="170" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding VoluntaryRestVisibility}" VerticalAlignment="Center">
                        <TextBlock Text="Take a real pause" Foreground="{StaticResource TextBrush}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Look far away, stretch, and breathe." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center" />
                        <Button Command="{Binding RestedCommand}" Content="Rested" HorizontalAlignment="Center" MinWidth="170" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
