<Window x:Class="EyeDragon.Views.PetOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="430" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize">
    <Grid IsHitTestVisible="False">
        <Border x:Name="Bubble" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0"
                Background="#F8F4FF" CornerRadius="14" Padding="15,9" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="2" />
            </Border.Effect>
            <TextBlock x:Name="BubbleText" Foreground="#22152F" FontSize="17" FontWeight="SemiBold" />
        </Border>
        <Image x:Name="PetImage" Width="300" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Uniform" />
    </Grid>
</Window>
