<Window x:Class="EyeDragon.Views.RestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Background="#F4100C1A"
        ShowInTaskbar="False" Topmost="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border Width="760" MaxWidth="760" Margin="40" Padding="52,42" CornerRadius="28"
                Background="#E9211932" BorderBrush="#72529B" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="PetImage" Stretch="Uniform" Margin="0,0,34,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Time to rest your eyes" Foreground="{StaticResource TextBrush}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Look at something far away. Stand up, stretch, or let your eyes relax."
                               Foreground="{StaticResource MutedBrush}" FontSize="17" LineHeight="26" TextWrapping="Wrap" Margin="0,14,0,24" />
                    <TextBlock x:Name="CountdownText" Foreground="White" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="62" />
                    <TextBlock x:Name="LockedText" Text="Your minimum rest is still in progress." Foreground="#C5B2D9" FontSize="14" Margin="0,4,0,20" />
                    <Button x:Name="RestedButton" Content="Rested" Click="RestedButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="180" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
