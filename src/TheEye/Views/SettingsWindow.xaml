<Window x:Class="TheEye.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheEye Settings" Width="540" Height="680" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34">
            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Timer durations apply to the next session. Appearance updates immediately." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,26" />

            <TextBlock Text="GENERAL" Foreground="{StaticResource EyeGlowBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBlock Text="Work duration (minutes)" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding WorkDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBlock Text="Minimum rest (minutes)" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding MandatoryRestMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
            </Grid>
            <CheckBox Content="Strict mode (prevent ordinary rest-window dismissal)" IsChecked="{Binding StrictModeEnabled}" Margin="0,5" />
            <CheckBox Content="Launch with Windows (always starts idle)" IsChecked="{Binding LaunchWithWindows}" Margin="0,5" />
            <CheckBox Content="Launch minimized to tray" IsChecked="{Binding LaunchMinimized}" Margin="0,5,0,24" />

            <TextBlock Text="WARNINGS" Foreground="{StaticResource EyeGlowBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <CheckBox Content="Five-minute warning" IsChecked="{Binding FiveMinuteWarningEnabled}" Margin="0,5" />
            <CheckBox Content="One-minute live countdown" IsChecked="{Binding OneMinuteWarningEnabled}" Margin="0,5,0,24" />

            <TextBlock Text="PET" Foreground="{StaticResource EyeGlowBrush}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="Pet size" />
            <Slider Minimum="0.5" Maximum="2" TickFrequency="0.1" Value="{Binding PetScale}" IsSnapToTickEnabled="True" Margin="0,6,0,10" />
            <CheckBox Content="Animate the floating companion" IsChecked="{Binding AnimationEnabled}" Margin="0,5" />
            <TextBlock Text="Animation speed" Margin="0,10,0,0" />
            <Slider Minimum="0.5" Maximum="2" TickFrequency="0.1" Value="{Binding AnimationSpeed}" IsSnapToTickEnabled="True" Margin="0,6,0,18" />
            <Button Content="Preview on taskbar (25 seconds)" Click="PreviewButton_Click" Background="#30392D" HorizontalAlignment="Left" />

            <TextBlock Text="SOUND" Foreground="{StaticResource EyeGlowBrush}" FontWeight="SemiBold" Margin="0,26,0,12" />
            <CheckBox Content="Warning sounds" IsChecked="{Binding WarningSoundsEnabled}" Margin="0,5" />
            <CheckBox Content="Rest-start sound" IsChecked="{Binding RestStartSoundEnabled}" Margin="0,5" />
            <TextBlock Text="Volume" Margin="0,10,0,0" />
            <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding Volume}" IsSnapToTickEnabled="True" Margin="0,6,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button x:Name="CancelSettingsButton" Content="Cancel" Click="CancelButton_Click" Background="#30392D" Margin="0,0,10,0" />
                <Button x:Name="SaveSettingsButton" Content="Save" Click="SaveButton_Click" MinWidth="110" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
