<Window x:Class="TheEye.Views.PetOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="524" Height="305" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize">
    <Grid IsHitTestVisible="False">
        <Border x:Name="Bubble" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0"
                Background="#F8F4FF" CornerRadius="14" Padding="15,9" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="2" />
            </Border.Effect>
            <TextBlock x:Name="BubbleText" Foreground="#22152F" FontSize="17" FontWeight="SemiBold" />
        </Border>
        <Image x:Name="PetImage" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,12" Stretch="Uniform"
               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</Window>
